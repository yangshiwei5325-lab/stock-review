# ---------------------------------------------------------------
# Windows 批处理必须保持 CRLF。
# cmd.exe 只认 CRLF：纯 LF 的 .bat 会导致行边界错乱，典型症状是
#   'ho' is not recognized        （echo 被吃掉前两个字符）
#   'xxx' is not recognized       （中文行被切碎报"不是内部或外部命令"）
# 这里用 -text 关闭一切换行转换，保证字节级原样存取。
# ---------------------------------------------------------------
*.bat -text
*.cmd -text
